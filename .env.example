# Server-only: the Next.js /api/* proxy target. Never exposed to the browser.
LACARTE_API_BASE_URL=https://lacarteprod.lazynerdstudios.com

# Client TomTom key for map tiles and search.
NEXT_PUBLIC_TOMTOM_API_KEY=your_tomtom_api_key_here

# Optional escape hatch: set to a full origin to call the API directly from the
# browser, bypassing the proxy. Requires the backend to allowlist this origin
# for CORS, which it does not do today.
# NEXT_PUBLIC_API_BASE_URL=
